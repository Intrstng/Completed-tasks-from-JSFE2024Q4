    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "npx eslint src",
    "lint:fix": "npx eslint \"{src,test}/**/*.js\" --fix",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "prepare": "husky"
  },
  "author": "Intrstng",
