{
    "name": "Async-race",
    "version": "1.0.0",
    "description": "",
    "main": "webpack.config.js",
    "private": true,
    "scripts": {
        "start": "webpack serve --open --config ./webpack.config.js --env mode=dev",
        "build": "webpack --config ./webpack.config.js --env mode=prod",
        "serve": "webpack serve",
        "lint": "npx eslint .",
        "lint-fix": "npm run lint -- --fix",
        "stylelint-check": "npx stylelint \"**/*.scss\"",
        "stylelint-fix": "npx stylelint --fix \"**/*.scss\"",
        "ci:format": "npx prettier src --check --ignore-unknown",
        "format": "npm run ci:format -- --write --ignore-unknown",
        "prepare": "husky"
    },
    "author": "Intrstng",
    "license": "ISC",
    "devDependencies": {
        "@commitlint/cli": "^19.8.0",
        "@commitlint/config-conventional": "^19.8.0",
        "@eslint/js": "^9.22.0",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/eslint-plugin-prettier": "^3.1.3",
        "@types/html-webpack-plugin": "^3.2.9",
        "@types/webpack-merge-and-include-globally": "^2.1.7",
        "@typescript-eslint/eslint-plugin": "^8.26.0",
        "@typescript-eslint/parser": "^8.26.0",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^13.0.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-unicorn": "^57.0.0",
        "favicons-webpack-plugin": "^6.0.1",
        "globals": "^16.0.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "3.5.3",
        "sass": "^1.85.1",
        "sass-loader": "^16.0.5",
        "source-map-support": "^0.5.21",
        "style-loader": "^4.0.0",
        "stylelint": "^16.15.0",
        "stylelint-config-clean-order": "^7.0.0",
        "stylelint-config-standard": "^37.0.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0",
        "webpack": "^5.98.0",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0",
        "webpack-merge": "^6.0.1"
    },
    "lint-staged": {
        "**/*.{js,ts}": [
            "prettier --write --ignore-unknown"
        ],
        "**/*.{css,scss}": [
            "stylelint",
            "prettier --write --ignore-unknown"
        ],
        "**/*.{json,html}": [
            "prettier --write --ignore-unknown"
        ]
    }
}
